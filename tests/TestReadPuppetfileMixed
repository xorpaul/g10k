
moduledir '/etc/puppet/modules'
forge.baseUrl 'https://forgeapi.puppetlabs.com'


mod 'puppetlabs/stdlib'
mod 'puppetlabs/stdlib2', '4.6.0'
mod 'a/a', '0.1.0'
mod 'a/b',
  :git => 'https://a/b.git'

mod 'a/c',
  :git => 'https://a/b.git',
  :ref => 'master'


# Install puppetlabs/apache and keep it up to date with 'master'
mod 'apache',
  :git => 'https://github.com/puppetlabs/puppetlabs-apache'

# Install puppetlabs/apache and track the 'docs_experiment' branch
mod 'apache2',
  :git => 'https://github.com/puppetlabs/puppetlabs-apache',
  :ref => 'docs_experiment'

# Install puppetlabs/apache and pin to the '0.9.0' tag
mod 'apache3',
  :git => 'https://github.com/puppetlabs/puppetlabs-apache',
  :tag => '0.9.0'

# Install puppetlabs/apache and pin to the '83401079' commit
mod 'apache4',
  :git    => 'https://github.com/puppetlabs/puppetlabs-apache',
  :commit => '83401079053dca11d61945bd9beef9ecf7576cbf'

# Install puppetlabs/apache and track the 'docs_experiment' branch
mod 'apache5',
  :git    => 'https://github.com/puppetlabs/puppetlabs-apache',
  :branch => 'docs_experiment'
mod 'hieradata',
  :git => 'git@git.example.com:organization/hieradata.git',
  :branch => :control_branch,
  :default_branch => 'foobar'
mod 'local_module', :local => true

# Equivalent to legacy syntax using supported attributes
mod 'apache6',
  :git => 'https://github.com/puppetlabs/puppetlabs-apache',
  :commit => '2098a17'

mod 'hieradata2',
  :git => 'git@git.example.com:organization/hieradata.git',
  :branch => :control_branch,
  :default_branch => 'master'
